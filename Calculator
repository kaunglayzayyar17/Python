number1 = float(input("Enter your first number: "))
number2 = float(input("Enter your second number: "))
operator = input("Enter your one operator: ")

result = 0

if operator == "+" :
    result = number1 + number2
elif operator == "-" :
    result = number1 - number2
elif operator == "*" :
    result = number1 * number2
elif operator == "/" :
    result = number1 / number2
else :
    result = 0

print (f"Result: {result}")